# ─────────────────────────────────────────────────────────────
# TechPulse Backend — environment template
# Copy to .env for local development. NEVER commit the real .env.
# Every value here is server-side only and must NOT be exposed to the browser.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──
# Supabase project URL and SERVICE ROLE key. The service role key bypasses RLS —
# treat it as a root credential. Server-side only, never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin portal (/campus-admin) ──
ADMIN_USERNAME=crisprisbest
ADMIN_EMAIL=crisprisbest@campuspulse.local
ADMIN_PASSWORD="change-me"
# Long random string. Signs admin JWTs — rotating it invalidates all sessions.
ADMIN_JWT_SECRET=set-a-long-random-secret-in-production
ADMIN_JWT_EXPIRES_IN=12h

# ── Scheduled jobs ──
# Required on Vercel. Vercel Cron sends it as `Authorization: Bearer <value>`;
# /api/cron/* refuses to run without it, so the jobs cannot be triggered by
# anyone who finds the URL. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Daily digest email ──
RESEND_API_KEY=
DIGEST_ENABLED=true
DIGEST_TO_EMAIL=bt25csh002@iiitn.ac.in
# Must be on a domain verified at resend.com/domains to reach any recipient.
# The shared onboarding@resend.dev sender only delivers to the Resend account owner.
DIGEST_FROM_EMAIL=TechPulse <onboarding@resend.dev>
DIGEST_SITE_URL=
# Used by the local node-cron scheduler only. On Vercel the schedule lives in
# vercel.json ("crons") and these are ignored.
DIGEST_CRON=0 7 * * *
DIGEST_TIMEZONE=Asia/Kolkata

# ── News ingest ──
NEWS_API_KEY=
WORKER_CRON=*/20 * * * *
RSS_CONCURRENCY=12

# ── Caching ──
# On Vercel the filesystem is read-only, so Redis is the only durable cache.
# Use a network Redis (e.g. Upstash) — a localhost URL will not work there.
# Leave REDIS_ENABLED unset/false to run without caching.
REDIS_ENABLED=false
REDIS_URL=
REDIS_KEY_PREFIX=techpulse:v1
REDIS_DEFAULT_TTL_SEC=300

# ── Optional integrations ──
# Raises the GitHub search rate limit (10/hr -> 30/min). Open Source page works without it.
GITHUB_TOKEN=
# Optional extra job source. The five keyless boards work without it.
EXA_API_KEY=
OPPORTUNITIES_FETCH_LIMIT=150

# ── Local development toggles ──
PORT=3000
# Set false to stop server.js starting the in-process cron scheduler.
ENABLE_LOCAL_CRON=true
# Force-disable filesystem caches (auto-disabled on Vercel).
DISABLE_DISK_CACHE=false
# Comma-separated extra CORS origins. Not needed on Vercel (same origin).
CORS_ORIGINS=

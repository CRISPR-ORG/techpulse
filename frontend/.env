# TechPulse Frontend
#
# Leave VITE_API_BASE_URL UNSET here.
#
# The API client falls back to the relative path "/api", which is what both
# environments need:
#   - production: frontend and API share one Vercel domain, so /api is correct
#   - local dev:  vite.config.js proxies /api to the backend on :3000
#
# Setting an absolute URL here would be compiled into the production bundle at
# build time and the deployed site would call that host instead of itself.
# For a one-off local override use .env.local (gitignored), not this file.

# Show the Open Source section locally
VITE_SHOW_OPENSOURCE=true

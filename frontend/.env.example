# TechPulse — Vite env template
# Copy to .env.local for local overrides. Only VITE_* keys reach the browser.

# Optional. Leave empty for same-origin "/api", which is correct for both
# Vercel (frontend and API share a domain) and local dev (Vite proxies /api).
# Only set this to point the frontend at a backend on a different host.
VITE_API_BASE_URL=

# Set to "true" to show the Open Source section in the navbar and route.
# Leave unset or empty in production to hide it.
VITE_SHOW_OPENSOURCE=

# TechPulse — Vite env template
# Copy to `.env` and adjust. Only `VITE_*` keys are exposed to the browser.

# Backend API base (no trailing slash). Unused until you wire fetch calls.
VITE_API_BASE_URL=

# When not "false", app can prefer mock data (optional; implement in code later).
VITE_USE_MOCK_DATA=true
